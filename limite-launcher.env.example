# limite-runner — configurazione del launcher Windows (opzionale)
#
# Copia questo file in "limite-launcher.env" (stessa cartella di
# Avvia-Limite-GPU.cmd) e decommenta/imposta solo le voci che ti servono.
# "limite-launcher.env" e' personale e NON va versionato.
#
# Precedenza: variabile d'ambiente gia' impostata > questo file > default.
# Gli stessi nomi valgono come variabili d'ambiente anche su Linux/WSL
# quando si lancia scripts/limite-serve.sh o `limite serve` direttamente.
#
# Percorsi Linux/WSL: usa il formato visto dentro WSL (/home/... o /mnt/c/...).
# Percorsi con spazi sono ammessi (scrivili senza apici).

# Distribuzione WSL da usare (default: Ubuntu)
#LIMITE_WSL_DISTRO=Ubuntu

# Cartella dati artefatti dentro WSL/Linux
# (default: /home/<utente>/.local/share/limite-runner)
#LIMITE_DATA_DIR=/home/<utente>/.local/share/limite-runner

# Binario llama-server patchato (default: autodetect — cartella build della
# repository o PATH; costruirlo con: CUDA=ON bash scripts/build_llamacpp.sh)
#LIMITE_LLAMA_SERVER=/home/<utente>/limite-build/tools/llama.cpp/build/bin/llama-server

# File modello GGUF (default: $LIMITE_DATA_DIR/conv/gguf/limite-1b-violetto-<QUANT>.gguf)
#LIMITE_MODEL=/home/<utente>/.local/share/limite-runner/conv/gguf/limite-1b-violetto-Q8_0.gguf

# Quantizzazione (default Q8_0) e contesto (default 16384)
#LIMITE_QUANT=Q8_0
#LIMITE_CTX=16384

# Host e porta della chat/API (default 127.0.0.1:8080)
#LIMITE_HOST=127.0.0.1
#LIMITE_PORT=8080

# GPU: 1 = offload GPU (-ngl 99), 0 = CPU (-ngl 0)   (default 1)
#LIMITE_GPU=1

# Limite di generazione in token; "length" = risposta troncata (default 2048)
#LIMITE_MAX_TOKENS=2048

# Checkout della repository dentro WSL/Linux: se impostato il launcher usa
# "<path>/.venv/bin/limite" (da "uv sync") oppure "uv run --project <path> limite".
#LIMITE_WSL_REPO=/home/<utente>/limite-runner

# Percorso esplicito dell'eseguibile `limite` (opzionale; ha la precedenza
# su LIMITE_WSL_REPO e sul PATH)
#LIMITE_BIN=/home/<utente>/.local/bin/limite

# Librerie per la build CUDA in WSL2 (default: /usr/lib/wsl/lib:/usr/local/cuda/lib64)
#LIMITE_LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/cuda/lib64
