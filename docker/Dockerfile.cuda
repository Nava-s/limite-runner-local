# limite-runner CUDA image (Ubuntu 24.04 + CUDA 13.0 devel + Python 3.12).
# Base for a future EC2/ECS/SageMaker deploy. The conversion's tested CUDA
# route used toolkit 12.8; RTX 50-series (sm_120) needs >= 12.8, and the
# validated torch stack is CUDA 13.0, hence this base.
FROM nvidia/cuda:13.0.0-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake g++ make curl ca-certificates python3.12 python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/limite-runner
COPY scripts/ scripts/
COPY tools/ tools/

ARG CONV_REV=24cae8a67a3d4186c679678be9240507064689d2
ARG PATCH_SHA256=0626d2e23c8eef43bee2e6e31acf574aa4757e4556fad42f146a3314cc12f418
RUN mkdir -p patches \
 && curl -fsSL -o patches/limite.patch \
      https://huggingface.co/Tdamre/limite-1b-violetto-GGUF-LiteRT/resolve/${CONV_REV}/runtime/limite.patch \
 && echo "${PATCH_SHA256}  patches/limite.patch" | sha256sum -c -

RUN JOBS=$(nproc) CUDA=ON bash scripts/build_llamacpp.sh --dir /opt/llama.cpp --patch /opt/limite-runner/patches/limite.patch

FROM nvidia/cuda:13.0.0-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LIMITE_LLAMA_SERVER=/opt/llama.cpp/build/bin/llama-server \
    LIMITE_LOGITS_BIN=/opt/llama.cpp/build/bin/limite-logits \
    LIMITE_DATA_DIR=/data
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates python3.12 python3.12-venv libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m pip install --no-cache-dir --break-system-packages uv
COPY --from=builder /opt/llama.cpp/build/bin/ /opt/llama.cpp/build/bin/
WORKDIR /opt/limite-runner
COPY pyproject.toml README.md ./
COPY src/ src/
# CUDA torch wheel (validated stack: torch 2.11 / CUDA 13.0). If the cu130
# index lacks a build, fall back to PyPI's default torch resolution.
RUN uv pip install --system --no-cache torch \
      --index-url https://download.pytorch.org/whl/cu130 \
 || uv pip install --system --no-cache torch
RUN uv pip install --system --no-cache ".[litert,transformers]"
COPY docker/entrypoint.sh /entrypoint.sh
# COPY does not carry the executable bit reliably (e.g. checkouts on
# case-insensitive/filesystem-mode-stripping hosts): force it.
RUN chmod 0755 /entrypoint.sh
VOLUME /data
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
